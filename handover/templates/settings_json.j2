{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "comment": "Generated by handover v{{ version }} for {{ scaffold.manifest.project }}",
  "hooks": {
{% for hook in scaffold.hooks %}
    "{{ hook.event }}": [{ "type": "command", "command": ".claude/hooks/{{ hook.name }}" }]{% if not loop.last %},{% endif %}

{% endfor %}
  }
}
